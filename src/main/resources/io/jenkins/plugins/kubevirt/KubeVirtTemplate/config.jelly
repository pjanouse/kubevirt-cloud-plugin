<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <!-- Hidden ID field to preserve template identity during edits -->
    <f:invisibleEntry>
        <input type="hidden" name="_.id" value="${instance.id}"/>
    </f:invisibleEntry>

    <f:entry title="Template Name" field="name">
        <f:textbox />
    </f:entry>
    <f:entry title="Labels" field="labels">
        <f:textbox />
    </f:entry>

    <!-- Disk source type and dependent fields (visibility toggled via config.js adjunct) -->
    <div class="disk-source-options"
         data-disk-source="${empty(instance.diskSourceType) ? 'containerDisk' : instance.diskSourceType}">
        <f:entry title="Disk Source Type" field="diskSourceType"
                 description="ContainerDisk: imports a container disk image directly into a DataVolume for each VM. DataSource (Clone): clones from a pre-existing DataSource in the cluster. DataSource (Import): imports a container image into a DataSource (cached), then clones from it for each VM — faster provisioning after the first import.">
            <f:select />
        </f:entry>
        <!-- DataSource Namespace + Name: shown for dataSource and dataSourceImport -->
        <div class="data-source-fields">
            <f:entry title="DataSource Namespace" field="dataSourceNamespace"
                     description="Kubernetes namespace where the DataSource resides (for Clone) or will be created (for Import).">
                <f:textbox default="${descriptor.defaultDataSourceNamespace}" />
            </f:entry>
            <f:entry title="DataSource Name" field="dataSourceName"
                     description="Name of the DataSource to clone from (for Clone) or to create (for Import).">
                <f:textbox />
            </f:entry>
        </div>
        <!-- Image: shown for containerDisk and dataSourceImport -->
        <div class="image-field">
            <f:entry title="Image" field="image"
                     description="Container disk image URL (e.g., quay.io/containerdisks/fedora:40). For ContainerDisk, imported directly into a DataVolume per VM. For DataSource (Import), imported once into a DataSource and cached for subsequent VMs.">
                <f:textbox />
            </f:entry>
        </div>
    </div>

    <f:entry title="Disk Size" field="diskSize">
        <f:textbox default="${descriptor.defaultDiskSize}" />
    </f:entry>

    <f:entry title="Access Mode" field="accessMode"
             description="RWX enables live migration but requires compatible storage. Use RWO if your storage doesn't support RWX.">
        <f:select />
    </f:entry>

    <f:section title="Resources">
        <f:description>
            Configure CPU and Memory allocation. Reserved values are guaranteed to the VM, while Limits cap the maximum.
            Reserved must be less than or equal to Limits.
        </f:description>
        <div class="resource-grid">
            <div class="resource-column">
                <h4>Reserved (Requests)</h4>
                <f:entry title="CPU" field="cpu">
                    <f:textbox default="${descriptor.defaultCpu}" />
                </f:entry>
                <f:entry title="Memory" field="memory">
                    <f:textbox default="${descriptor.defaultMemory}" />
                </f:entry>
            </div>
            <div class="resource-column">
                <h4>Limits (Maximum)</h4>
                <f:entry title="CPU Limit" field="cpuLimit">
                    <f:textbox />
                </f:entry>
                <f:entry title="Memory Limit" field="memoryLimit">
                    <f:textbox />
                </f:entry>
            </div>
        </div>
    </f:section>
    
    <f:section title="Cloud-Init Configuration">
        <f:entry title="Cloud-Init Config" field="cloudInitId"
                 description="Select a cloud-init configuration for SSH key injection and VM setup. Manage configs in: Manage Jenkins → Managed Files">
            <f:select />
        </f:entry>
        <f:entry title="Add /tmp mount" field="injectTmpDiskConfig">
            <f:checkbox default="${descriptor.defaultInjectTmpDisk}" />
        </f:entry>
        <f:entry title="Cloud-Init Wait (seconds)" field="cloudInitWaitSeconds"
                 description="Maximum time to wait for cloud-init to finish SSH setup before connecting (virtctl SSH only). Increase if cloud-init installs packages or runs long runcmd scripts.">
            <f:number default="${descriptor.defaultCloudInitWaitSeconds}" min="1" />
        </f:entry>
    </f:section>
    
    <f:section title="SSH Connection Settings">
        <f:entry title="Connection Type" field="connectionType"
                 description="How Jenkins connects to the VM">
            <f:select />
        </f:entry>
        <f:entry title="SSH Credentials" field="sshCredentialsId" 
                 description="SSH credentials (username/password or SSH key) to connect to the VM">
            <c:select />
        </f:entry>
        <f:entry title="SSH Port" field="sshPort"
                 description="SSH port on the VM (used for Direct SSH only, virtctl always uses port 22)">
            <f:number default="${descriptor.defaultSshPort}" min="1" max="65535" />
        </f:entry>
        <f:entry title="Remote FS Root" field="remoteFS" 
                 description="Directory on the VM where Jenkins agent will run">
            <f:textbox default="${descriptor.defaultRemoteFS}" />
        </f:entry>
        <f:entry title="Java Path" field="javaPath" 
                 description="Optional: Path to java executable on the VM (leave empty to use PATH)">
            <f:textbox />
        </f:entry>
    </f:section>
    
    <f:section title="Agent Retention">
        <f:entry title="Instance Cap" field="instanceCap">
            <f:number default="${descriptor.defaultInstanceCap}" min="0" />
        </f:entry>
        <f:entry title="Idle Minutes" field="idleMinutes"
                 description="How long (in minutes) the VM stays alive after becoming idle. Set to 0 to dispose immediately after the first build.">
            <f:number default="${descriptor.defaultIdleMinutes}" min="0" />
        </f:entry>
        <f:entry title="Orphan Grace Period (minutes)" field="orphanGracePeriodMinutes"
                 description="How long a VM must exist without a registered agent before being considered orphaned and cleaned up.">
            <f:number default="${descriptor.defaultOrphanGracePeriodMinutes}" min="0" />
        </f:entry>
    </f:section>

    <f:section title="VM Provisioning">
        <f:entry title="Provisioning Timeout (minutes)" field="provisioningTimeoutMinutes"
                 description="Maximum time to wait for the VM to be ready and get an IP address. Increase if disk cloning takes longer.">
            <f:number default="${descriptor.defaultProvisioningTimeoutMinutes}" min="1" />
        </f:entry>
        <f:entry title="Max Provision Attempts" field="maxProvisionAttempts"
                 description="Number of extra VM provisioning tries after the first failure before cancelling builds whose assigned label is satisfied by this template. 0 = no retries, 1 = one retry (default), -1 = unlimited (not recommended).">
            <f:number default="${descriptor.defaultMaxProvisionAttempts}" min="-1" />
        </f:entry>
    </f:section>

    <st:adjunct includes="io.jenkins.plugins.kubevirt.KubeVirtTemplate.config"/>
</j:jelly>
