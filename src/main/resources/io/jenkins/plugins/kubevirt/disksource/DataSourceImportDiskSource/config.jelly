<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="DataSource Namespace" field="dataSourceNamespace"
             description="Kubernetes namespace where the DataSource will be created.">
        <f:textbox default="${descriptor.defaultDataSourceNamespace}" />
    </f:entry>
    <f:entry title="DataSource Name" field="dataSourceName"
             description="Name of the DataSource to create and clone from.">
        <f:textbox />
    </f:entry>
    <f:entry title="Image" field="image"
             description="Container disk image URL. Imported once into a DataSource and cached for subsequent VMs.">
        <f:textbox />
    </f:entry>
</j:jelly>
